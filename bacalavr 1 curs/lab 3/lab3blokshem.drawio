        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% Заголовок и подключение библиотек (как на твоем скриншоте)\n    subgraph Header [\&quot; \&quot;]\n        Inc[\&quot;#include &amp;lt;iostream&amp;gt;&lt;br&gt;#include &amp;lt;cmath&amp;gt;&lt;br&gt;using namespace std;\&quot;]\n    end\n\n    Start([Начало])\n    Header -.-&gt; Start\n\n    Main[[\&quot;int main()\&quot;]]\n    Start --&gt; Main\n\n    %% Инициализация переменных\n    Init[\&quot;double a = 0.1, b = 1.0&lt;br&gt;int k = 10&lt;br&gt;double h = (b - a) / k&lt;br&gt;int n_fixed = 35&lt;br&gt;double eps = 0.0001\&quot;]\n    Main --&gt; Init\n\n    %% Внешний цикл по x\n    LoopX{{for (double x = a; x &lt;= b + 1e-9; x += h)}}\n    Init --&gt; LoopX\n\n    %% Точное значение\n    CalcY[\&quot;y_exact = (1 - x²/2)*cos(x) - (x/2)*sin(x)\&quot;]\n    LoopX --&gt; CalcY\n\n    %% Вычисление SN\n    InitSN[\&quot;SN = 0&lt;br&gt;i = 0\&quot;]\n    CalcY --&gt; InitSN\n\n    LoopSN{{for (int i = 0; i &lt;= n_fixed; i++)}}\n    InitSN --&gt; LoopSN\n\n    FactN[\&quot;fact = 1&lt;br&gt;j = 1\&quot;]\n    LoopSN --&gt; FactN\n\n    LoopFactN{{for (j &lt;= 2 * i)}}\n    FactN --&gt; LoopFactN\n\n    CalcFactN[\&quot;fact *= j&lt;br&gt;j++\&quot;]\n    LoopFactN --&gt; CalcFactN\n    CalcFactN --&gt; LoopFactN\n\n    AddSN[\&quot;SN += pow(-1,i)*(2i²+1)/fact * x^(2i)\&quot;]\n    LoopFactN --&gt; AddSN\n    AddSN --&gt; LoopSN\n\n    %% Вычисление SE\n    InitSE[\&quot;SE = 0&lt;br&gt;i = 0\&quot;]\n    LoopSN --&gt; InitSE\n\n    WhileSE{while (true)}\n    InitSE --&gt; WhileSE\n\n    FactE[\&quot;fact = 1&lt;br&gt;j = 1\&quot;]\n    WhileSE --&gt; FactE\n\n    LoopFactE{{for (j &lt;= 2 * i)}}\n    FactE --&gt; LoopFactE\n\n    CalcFactE[\&quot;fact *= j&lt;br&gt;j++\&quot;]\n    LoopFactE --&gt; CalcFactE\n    CalcFactE --&gt; LoopFactE\n\n    CalcTerm[\&quot;term = pow(-1,i)*(2i²+1)/fact * x^(2i)\&quot;]\n    LoopFactE --&gt; CalcTerm\n\n    CheckEps{abs(term) &lt; eps&lt;br&gt;и i &gt; 0?}\n    CalcTerm --&gt; CheckEps\n\n    AddSE[\&quot;SE += term&lt;br&gt;i++\&quot;]\n    CheckEps -- \&quot;Нет\&quot; --&gt; AddSE\n\n    CheckMax{i &gt; 200?}\n    AddSE --&gt; CheckMax\n    CheckMax -- \&quot;Нет\&quot; --&gt; WhileSE\n\n    %% Выход из SE (по точности или лимиту)\n    CheckEps -- \&quot;Да\&quot; --&gt; Output\n    CheckMax -- \&quot;Да\&quot; --&gt; Output\n\n    %% Вывод результатов\n    Output[/cout &lt;&lt; X, SN, SE, y_exact/]\n    Output --&gt; LoopX\n\n    %% Завершение\n    LoopX -- \&quot;Нет\&quot; --&gt; Ret([return 0;])&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="PIYS_BZw9PLZdsz5VaSB-190">
