        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    Start([Начало]) --&gt; Main[int main]\n    Main --&gt; Locale[setlocale LC_ALL, .UTF8;]\n    Locale --&gt; Vars[int a[100][100];\\nint n;]\n    Vars --&gt; InN[/cin &gt;&gt; n;/]\n    \n    InN --&gt; LoopInI{\&quot;for (int i = 0; i &lt; n; i++)\&quot;}\n    LoopInI --&gt; LoopInJ{\&quot;for (int j = 0; j &lt; n; j++)\&quot;}\n    LoopInJ --&gt; InA[/cin &gt;&gt; a[i][j];/]\n    InA --&gt; LoopInJ\n    LoopInJ --&gt;|Выход| LoopInI\n\n    LoopInI --&gt; Sum0[double sum = 0;]\n    Sum0 --&gt; Loop1{\&quot;for (int i = 0; i &lt; n; i++)\&quot;}\n    Loop1 --&gt; Add1[sum += a[i][0];]\n    Add1 --&gt; Loop1\n\n    Loop1 --&gt;|Выход| Avg0[double avg = sum / n;]\n    Avg0 --&gt; OutAvg[/cout &lt;&lt; avg;/]\n\n    OutAvg --&gt; LoopJ{\&quot;for (int j = 1; j &lt; n; j++)\&quot;}\n    LoopJ --&gt; Count0[int count = 0;]\n    Count0 --&gt; LoopI{\&quot;for (int i = 0; i &lt; n; i++)\&quot;}\n    \n    LoopI --&gt; Cond{\&quot;if (a[i][j] &gt; avg)\&quot;}\n    Cond -- Да --&gt; Inc[count++;]\n    Cond --&gt; OutCount\n    Inc --&gt; OutCount\n\n    LoopI --&gt;|Выход| OutCount[/cout &lt;&lt; count;/]\n    OutCount --&gt; SumReset[sum = 0;]\n    SumReset --&gt; LoopRecalc{\&quot;for (int i = 0; i &lt; n; i++)\&quot;}\n    LoopRecalc --&gt; AddRecalc[sum += a[i][j];]\n    AddRecalc --&gt; LoopRecalc\n    \n    LoopRecalc --&gt;|Выход| AvgRecalc[avg = sum / n;]\n    AvgRecalc --&gt; LoopJ\n\n    LoopJ --&gt;|Выход| Ret[return 0;]\n    Ret --&gt; End([Конец])\n\n    %% Тонкие линии, белая заливка и строгий ГОСТ-стиль\n    classDef default fill:#ffffff,stroke:#000000,stroke-width:1px,font-family:Courier New,font-size:12px;\n    classDef cond fill:#ffffff,stroke:#000000,stroke-width:1px;\n    class Start,End default;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="q0GDe-jbBz0t4AqQMY53-1">
